{
  "name": "@celestio/astro-selfie",
  "version": "2.0.0",
  "description": "Astro integration to generate page screenshots to show as Open Graph images",
  "license": "ISC",
  "author": {
    "name": "Yann V.",
    "email": "yann@celest.io",
    "url": "https://github.com/celest-io"
  },
  "homepage": "https://github.com/celest-io/astro-selfie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celest-io/astro-selfie.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepare": "rm -rf dist && tsc",
    "check": "oxlint && oxfmt --check .",
    "check.format": "oxfmt --check .",
    "check.lint": "oxlint",
    "fix": "pnpm lint && pnpm format",
    "format": "oxfmt .",
    "lint": "oxlint --fix"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "astro-integration",
    "astro"
  ],
  "dependencies": {
    "@playwright/browser-chromium": "^1.63.0",
    "get-port": "^7.2.0",
    "micro": "^10.0.1",
    "playwright": "^1.63.0",
    "serve-handler": "^6.1.7",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/serve-handler": "^6.1.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  }
}
